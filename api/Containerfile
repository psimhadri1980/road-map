# T013: Maven builds the jar; only the JRE and the jar reach the runtime image (non-root, read-only
# root filesystem are set by api/component.yaml). Base images are pinned in run/env/images.env.
ARG MAVEN_IMAGE
ARG JRE_IMAGE
FROM ${MAVEN_IMAGE} AS build
WORKDIR /build
COPY component/pom.xml .
COPY component/src src
# The gantt files run/run.sh stages from the pinned submodule (api/component.yaml build.files).
COPY app/gantt /build/gantt/packages
RUN mvn -B -q -DskipTests -Dgantt.dir=/build/gantt package

FROM ${JRE_IMAGE}
COPY --from=build /build/target/api-*.jar /app/api.jar
USER 1000:1000
ENTRYPOINT ["java", "-jar", "/app/api.jar"]
