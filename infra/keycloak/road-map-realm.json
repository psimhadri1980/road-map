    }
  ],
  "groups": [
    {
      "name": "alpha",
      "path": "/alpha",
      "subGroups": [
        {
          "name": "viewer",
          "path": "/alpha/viewer"
        },
        {
          "name": "editor",
          "path": "/alpha/editor"
        },
        {
          "name": "reviewer",
