# Keycloak (T011): the published image with its build-time options applied, so the container can
# run `start --optimized` on a read-only root filesystem (a plain `start` would rebuild into /opt).
ARG KEYCLOAK_IMAGE
FROM ${KEYCLOAK_IMAGE}
RUN /opt/keycloak/bin/kc.sh build --db=postgres --health-enabled=true
# The base image already runs as uid 1000 (keycloak); said here so the image cannot silently become root (T034).
USER 1000
