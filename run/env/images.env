# Base and service images, pinned in one place. Loaded with the other env files (see common.env),
# so component.yaml files interpolate them (${POSTGRES_IMAGE}) and run.sh passes them to the Containerfiles as build args.
# Flat KEY=value lines only. Bump a version or digest here and nowhere else.

# npm registry for every install (image builds and host pnpm/npx). Point it at your organization's
# registry (Artifactory, Nexus, Verdaccio, ...) to use it everywhere; put it in local.env to keep it out of git.
NPM_REGISTRY=https://registry.npmjs.org

# Build bases (digest-pinned)
NODE_IMAGE=docker.io/library/node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85
NODE_SLIM_IMAGE=docker.io/library/node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.30.6-alpine

# Data stores, identity and the Java build, tags from specs/001-walking-skeleton/research.md R1.
# Digests are added next to each tag when its component lands (T006-T014).
POSTGRES_IMAGE=docker.io/library/postgres:18.7-alpine
REDIS_IMAGE=docker.io/library/redis:8.8.4-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
MAVEN_IMAGE=docker.io/library/maven:3.10.0-eclipse-temurin-25
JRE_IMAGE=docker.io/library/eclipse-temurin:25-jre-alpine
